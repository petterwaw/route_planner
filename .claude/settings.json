{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format-frontend.sh\"",
            "timeout": 60,
            "statusMessage": "Prettier i ESLint na pliku frontendu"
          }
        ]
      }
    ]
  }
}
